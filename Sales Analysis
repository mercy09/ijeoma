      "source": [
        "Customer Segmentation — K-Means Clustering"
      ],
      "metadata": {
        "id": "LOT6_FkUvawu"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#Can we divide mall customers into groups with similar characteristics?\n",
        "#Low income / low spending\n",
        "#High income / high spending\n",
        "#High income / low spending\n",
        "#Low income / high spending\n",
        "#Medium income / medium spending\n",
        "\n",
        "#select Variables\n",
        "\n",
        "X = df[\n",
        "    [\"Income\", \"Spending_Score\"]\n",
        "]"
      ],
      "metadata": {
        "id": "bf3cyEWgvjxR"
      },
      "execution_count": 52,
      "outputs": []
